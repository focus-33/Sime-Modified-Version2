<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <!-- IME service -->
        <service
            android:name=".SimeService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Launcher / setup activity. NoActionBar so we can render
             our own title inside the layout. -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Personal dictionary editor, launched from the IME dictionary panel. -->
        <activity
            android:name=".QuickPhraseEditActivity"
            android:label="个人字典"
            android:exported="false" />

        <!-- Creates a user-editable TXT backup of the two learning stores. -->
        <activity
            android:name=".ExportLearningActivity"
            android:label="导出自学习文件"
            android:exported="false" />

        <activity
            android:name=".ImportLearningActivity"
            android:label="导入自学习文件"
            android:exported="false" />

    </application>

</manifest>
